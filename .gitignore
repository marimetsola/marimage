# Environment files
.env
.env.*
!.env.example

# Temporary / editor files
# Editor backup and temporary files
*~
.*.un~

# Uploaded images
# Uploaded images are runtime data and should not be stored in Git
storage/dev/images/*
# Keep the directory itself in the repository
!storage/dev/images/.gitkeep

# Generated development thumbnails
storage/dev/thumbnails/*
!storage/dev/thumbnails/.gitkeep

# Python cache / compiled files
__pycache__/
*.py[cod]

# Node.js dependencies and build output
node_modules/
dist/
build/

# IDE configuration
.idea/

# Log files
*.log

# Vim swap files
*.swp
*.swo

# Local production-test uploads and thumbnails
storage/prod/images/*
!storage/prod/images/.gitkeep
storage/prod/thumbnails/*
!storage/prod/thumbnails/.gitkeep
